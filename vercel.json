{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=optional",
  "headers": [
    {"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"private, no-store"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/codecs/avif-2.1.1/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/:path*","headers":[{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}
  ]
}
