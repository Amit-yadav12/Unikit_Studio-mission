{
  "name": "unikit-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Unikit Studio: image, document and web-asset tools that run in the browser. Files are processed on the visitor's device and are never uploaded.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/index.ts",
    "netlify:dev": "npx --yes netlify-cli@27.16.2 dev --offline",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --import tsx scripts/core-selftest.mjs",
    "test:pipeline": "node --import tsx scripts/pipeline-selftest.mjs",
    "test:ui": "node --import tsx scripts/ui-outcome-selftest.mjs",
    "test:documents": "node --import tsx scripts/documents-selftest.mjs",
    "test:dom": "node --import tsx scripts/optimizer-dom-selftest.mjs",
    "test:audit": "node --import tsx scripts/audit-selftest.mjs",
    "test:api": "node --import tsx scripts/api-selftest.mjs",
    "test:security": "node --import tsx scripts/security-probe.mjs",
    "test:function": "node --import tsx scripts/netlify-function-selftest.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:browser": "node --import tsx scripts/browser-selftest.mjs",
    "smoke": "node scripts/deployed-smoke.mjs",
    "brand:assets": "node scripts/make-brand-assets.mjs",
    "test:release": "node scripts/release-selftest.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "node-html-parser": "^7.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7"
  }
}
